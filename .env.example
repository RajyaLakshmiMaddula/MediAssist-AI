# Copy this file to ".env" and adjust the values.
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env

# Signs session cookies and CSRF tokens. Any long random string works for
# local development. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# "development" enables the debugger and auto-reload. Use "production" when
# deploying, which also forces secure cookies.
FLASK_CONFIG=development

# Defaults to a SQLite file (database.db) next to app.py. Leave it commented
# out unless you are pointing at another database.
# DATABASE_URL=sqlite:///database.db
